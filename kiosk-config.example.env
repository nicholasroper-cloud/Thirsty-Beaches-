# kiosk-config.example.env — setting NAMES only. The real file is kiosk-config.env on the
# kiosk PC and holds secrets: it is NEVER committed, published or downloaded by an update.
# Settings marked [remote] can also be overridden from kiosk-control.json "settings"
# (Thirsty-Beaches-Control repo / owner app) without touching the PC.
# Keep comments on their own lines (no "# ..." after a value).

# --- Clover (secret) ---
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=
CLOVER_BASE_URL=https://api.clover.com
PORT=8137

# --- AI (secret key) ---
ANTHROPIC_API_KEY=
# [remote]
VIBE_MODEL=claude-haiku-4-5
# [remote]
AI_DESIGN_ENABLED=false
# [remote]
DRINK_MODEL=claude-haiku-4-5

# --- Server-side pricing and orders (the kiosk page sends what was picked; the server prices it from Clover) ---
# atomic (default) or legacy. atomic prices carts from the Clover catalog (catalog-map.json, see catalog-gap-report.md) and creates orders atomically,
# but only for carts whose every key is mapped and only while KIOSK_ORDER_TYPE_ID is set; anything else uses the legacy order path.
# legacy forces the old line-by-line order path everywhere (the rollback switch).
ORDER_PATH=atomic
# The Clover order type id of kiosk orders (Clover dashboard > Setup > Order types; create one called Kiosk). Blank = server-side pricing stays OFF.
# Also set it for the Make Station (this same file) and as KIOSK_ORDER_TYPE_ID in cloud/wrangler.toml so tickets are released only when paid or marked COLLECT.
KIOSK_ORDER_TYPE_ID=
# The tax rates (in percent, comma separated) the kiosk expects Clover to charge here, for example 7 or 6.5,7. Blank = card payment stays OFF (fail closed).
# The trailer changes counties: update this together with the Clover default tax rate at every stop (pre-service checklist).
CATALOG_TAX_RATES=
# A mapped item priced under this many cents holds card payment and raises a heartbeat alert (default 25).
# CATALOG_PRICE_FLOOR_CENTS=25
# If Clover prices move more than 50% the new prices are NOT taken and card payment is held; to accept them on purpose, create the empty file .tb/catalog-accept.flag.

# --- Remote updates / control ---
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/nicholasroper-cloud/Thirsty-Beaches-/main/update-manifest.json
# [remote] 5..1440
UPDATE_INTERVAL_MIN=60
CONTROL_URL=https://raw.githubusercontent.com/nicholasroper-cloud/Thirsty-Beaches-Control/main/kiosk-control.json
# healthchecks.io ping URL (keep private)
HEALTHCHECK_URL=
# KIOSK_HEARTBEAT_URL=off              # status heartbeat; default is the tb-where worker /kiosk/ping

# --- Tap-to-pay (Clover Flex) ---
# Pay is local only: the public Control file can NEVER turn it on, move the reader, or change a timeout. It can only switch pay OFF.
# A NEW card Sale is allowed only when ALL THREE hold:
#   1. PAY_ENABLED=true below (this file; a restart is needed to change it)
#   2. the file .tb/pay-off.flag does NOT exist (local kill: create the empty file to stop new card Sales at once, delete it to resume)
#   3. the Control file's payEnabled is not the literal boolean false (remote kill; the last answer is remembered in .tb/pay-remote-kill.json
#      and kept if GitHub is unreachable; a remote kill is logged and shows in the status heartbeat as pay.remoteKill)
# A kill stops NEW Sales only. The pay journal (.tb/pay-journal.jsonl), the reconcile loop and the Clover tag retries never stop.
# Keep PAY_ENABLED=false until the eight real-Flex acceptance tests in the ADR (section 8) pass.
PAY_ENABLED=false
# the Flex's address on the trailer LAN (a fixed DHCP lease or static IP)
FLEX_IP=
FLEX_PORT=12345
# wss (default) or ws; keep wss
FLEX_WS_SCHEME=wss
# Milliseconds the reader may show the card prompt before the kiosk starts asking the device what happened. 15000..300000, default 60000.
# Boot assertion: with PAY_ENABLED=true the server REFUSES TO START unless TB_IDLE_MS > PAY_TIMEOUT_MS + 45000
# (the screen idle timer must outlast the prompt plus recovery: 30 s extension + 10 s answer + margin).
PAY_TIMEOUT_MS=60000
# Milliseconds of no customer activity before the screen resets and an idle restart may happen. Default 120000.
# With the default PAY_TIMEOUT_MS this is already enough (120000 > 105000); raise it if you raise PAY_TIMEOUT_MS.
# TB_IDLE_MS=120000
# The pay-screen countdowns, in milliseconds (1000..120000). Defaults are the design's 20 / 30 / 10 seconds.
#   PAY_UNKNOWN_HOLD_MS     how long "We're checking your payment, don't pay again" stays up before the screen resets (the order is kept, locked)
#   PAY_DECLINED_WAIT_MS    after a declined or cancelled card: wait this long, then show "Still there?"
#   PAY_STILL_THERE_MS      how long "Still there?" shows before the unpaid order is abandoned (the server checks the reader is idle, then deletes it)
# How many card attempts (POST /pay) the kiosk accepts per minute. Default 6 (security review Q5); over the limit the customer is sent to the window.
# A busy trailer with several card customers a minute may need more: raise it here rather than removing the limit.
# PAY_RATE_PER_MIN=6
# PAY_UNKNOWN_HOLD_MS=20000
# PAY_DECLINED_WAIT_MS=30000
# PAY_STILL_THERE_MS=10000
# One line shown on the pay screen under the total, in your own words, saying where the reader is (for example: The reader is on the right of this screen).
# Blank = no location line is shown. The kiosk never guesses.
READER_LOCATION_TEXT=
# also the kiosk id on the status page
POS_NAME=ThirstyBeaches-Kiosk
# where the Flex pairing token is kept (a secret: never commit it, never put it in a synced folder)
FLEX_PAIRING_FILE=flex-pairing.json
# Files the pay code keeps under .tb/ (never published, never overwritten by an update):
#   pay-journal.jsonl[.YYYY-MM-DD]  every card attempt (ids, amounts, last4, brand; never card data); rotated daily, resolved files purged after 30 days, capped at 50 MB
#   pay-token.key                   the key behind each order's payToken (created on first use when PAY_ENABLED=true)
#   pay-remote-kill.json            the last remote kill answer
#   pay-off.flag                    the local kill (you create it)
# Node must trust the Clover device CA for wss to the Flex: set NODE_EXTRA_CA_CERTS=<path to the Clover CA .pem> (or run node with --use-system-ca).
# Never set NODE_TLS_REJECT_UNAUTHORIZED=0.

# --- Other ---
# [remote] comma-separated Clover category names
HIDE_CATEGORIES=
STATION_CLOUD_KEY=

# --- Make Station (make-station-server.js, optional) ---
# Needed for the Echo Show to reach the station over Wi-Fi. Use a long random secret; open the Show once with ?k=<secret>.
STATION_KEY=
# Listen on this address. Default 127.0.0.1 (this PC only), or 0.0.0.0 when STATION_KEY is set (0.0.0.0 without a key is refused).
# MAKE_BIND=

# --- Time zone and daily order numbers ---
# The cloud station numbers each day (101, 102, ...) in OWNER_TZ (a Cloudflare Worker variable, default America/Denver). The kiosk PC and the
# local station use THIS PC's clock. OWNER_TZ MUST be the trailer's own zone (e.g. America/New_York for Florida) and this PC must be set to
# the same zone, or Register and phone orders get different numbers on the two stations.

# --- Worker handshake (tb-where / website AI) ---
# Shared secret the kiosk sends as X-Kiosk-Key when it burns a Maze prize code and when it forwards Snap a pic / Match My Vibe. Get the
# value from the Worker's KIOSK_KEY secret. Never published, never in the repo.
KIOSK_KEY=
