# kiosk-config.example.env — setting NAMES only. The real file is kiosk-config.env on the
# kiosk PC and holds secrets: it is NEVER committed, published or downloaded by an update.
# Settings marked [remote] can also be overridden from kiosk-control.json "settings"
# (Thirsty-Beaches-Control repo / owner app) without touching the PC.
# Keep comments on their own lines (no "# ..." after a value).

# --- Clover (secret) ---
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=
CLOVER_BASE_URL=https://api.clover.com
PORT=8137

# --- AI (secret key) ---
ANTHROPIC_API_KEY=
# [remote]
VIBE_MODEL=claude-haiku-4-5
# [remote]
AI_DESIGN_ENABLED=false
# [remote]
DRINK_MODEL=claude-haiku-4-5

# --- Remote updates / control ---
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/nicholasroper-cloud/Thirsty-Beaches-/main/update-manifest.json
# [remote] 5..1440
UPDATE_INTERVAL_MIN=60
CONTROL_URL=https://raw.githubusercontent.com/nicholasroper-cloud/Thirsty-Beaches-Control/main/kiosk-control.json
# healthchecks.io ping URL (keep private)
HEALTHCHECK_URL=
# KIOSK_HEARTBEAT_URL=off              # status heartbeat; default is the tb-where worker /kiosk/ping

# --- Tap-to-pay (Clover Flex) ---
# [remote]
PAY_ENABLED=false
# [remote]
FLEX_IP=
# [remote]
FLEX_PORT=12345
FLEX_WS_SCHEME=wss
# [remote] 15000..300000
PAY_TIMEOUT_MS=90000
# also the kiosk id on the status page
POS_NAME=ThirstyBeaches-Kiosk
FLEX_PAIRING_FILE=flex-pairing.json

# --- Other ---
# [remote] comma-separated Clover category names
HIDE_CATEGORIES=
STATION_CLOUD_KEY=
